import type { Detector, Finding, Severity } from '@crypt-kit/core';
import { z } from 'zod';
import { SAMPLE_ITEMS } from './fixtures';

// STEP 1 of 4: what to watch. See .kiro/steering/detector-contract.md.
// This stub reads a JSON list of { id, title, value, url } and reports every item whose
// value is at or over a threshold. Replace it with your own source and rule. Keep the
// contract: no model calls here, stable keys, plain-JSON payloads, throw on failure.

/** Only values that change when something real happens, so a spared haunt isn't redrafted for nothing. */
export const itemSchema = z.object({
  id: z.string().min(1).max(100),
  title: z.string(),
  value: z.number(),
  threshold: z.number(),
  url: z.url().nullable(),
});

export type Item = z.infer<typeof itemSchema>;

const feedSchema = z.array(
  z.object({ id: z.union([z.string(), z.number()]).transform(String), title: z.string(), value: z.number(), url: z.url().nullable().optional() }),
);

export interface ItemsOptions {
  /** A JSON feed. Without one, the detector reports SAMPLE_ITEMS (for the demo and tests). */
  sourceUrl: string | null;
  threshold: number;
}

const severityFor = (value: number, threshold: number): Severity => (value >= threshold * 2 ? 'high' : value >= threshold * 1.5 ? 'medium' : 'low');

export function createItemsDetector({ sourceUrl, threshold }: ItemsOptions): Detector<Item> {
  return {
    id: '{{name}}-items',
    payloadSchema: itemSchema,
    async poll(ctx) {
      let raw: unknown = SAMPLE_ITEMS;
      if (sourceUrl) {
        // Always ctx.fetch: tests serve recorded routes through it.
        const res = await ctx.fetch(sourceUrl, { headers: { accept: 'application/json' }, signal: ctx.signal });
        if (!res.ok) throw new Error(`The source returned ${res.status}`);
        raw = await res.json();
      }
      const items = feedSchema.parse(raw);
      const observedAt = ctx.now().toISOString();
      return items
        .filter((i) => i.value >= threshold)
        .map(
          (i): Finding<Item> => ({
            key: i.id, // stable: the source's own ID, never a title or position
            kind: 'item',
            severity: severityFor(i.value, threshold),
            title: i.title,
            url: i.url ?? null,
            observedAt,
            payload: { id: i.id, title: i.title, value: i.value, threshold, url: i.url ?? null },
          }),
        );
    },
  };
}
